{
  "name": "BiLiSongVideo-desktop",
  "version": "1.1.0",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-as-wallpaper": "^2.0.3",
    "element-plus": "^2.7.3",
    "koffi": "^3.0.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.2.8"
  },
  "build": {
    "appId": "com.bilibili.songvideo",
    "productName": "BLSV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
