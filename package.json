{
  "name": "BiLiSongVideo-desktop",
  "version": "1.5.0",
  "author": "liaoran2002",
  "description": "基于 Electron + Vue 3 构建的 B站音乐视频播放器,支持歌单自动播放和桌面壁纸模式。",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "wallDev": "concurrently \"vite\" \"electron . --wallpaper-mode\"",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-as-wallpaper": "^2.0.3",
    "element-plus": "^2.14.2",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.bilibili.songvideo",
    "productName": "BLSV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/bili.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
